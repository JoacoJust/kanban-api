    {
      "name": "POST /api/boards - Crear tablero válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tablero de Pruebas\",\n  \"description\": \"Tablero para testing\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/boards",
          "host": ["{{baseUrl}}"],
          "path": ["api", "boards"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has boardId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData._id).to.exist;",
              "    pm.collectionVariables.set(\"boardId\", jsonData._id);",
              "    ",
              "    // Guardar IDs de las 3 columnas básicas",
              "    if (jsonData.columns && jsonData.columns.length >= 3) {",
              "        pm.collectionVariables.set(\"todoColumnId\", jsonData.columns[0]._id);",
              "        pm.collectionVariables.set(\"doingColumnId\", jsonData.columns[1]._id);",
              "        pm.collectionVariables.set(\"doneColumnId\", jsonData.columns[2]._id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
